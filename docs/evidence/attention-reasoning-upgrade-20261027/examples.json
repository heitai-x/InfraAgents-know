      "family": "communication",
      "example": "four_stage_pipeline",
      "document": "knowledge/hardware/host-device-transfer.md",
      "section": "设定算例：阶段、槽位与共享带宽",
      "inputs": {
        "stage_ms": [
          3,
          2,
          8,
          1
        ],
        "batches": 8,
        "period_ms": 8,
        "input_MiB": 16,
        "output_MiB": 1
      },
      "assumptions": [
        "Independent deterministic stage resources, no extra dependencies.",
        "Each input lives from H2D start to GPU completion; each output from GPU start to D2H completion.",
        "Half-open lifetimes permit immediate reuse at a completion boundary."
      ],
      "evidence_class": "synthetic_arithmetic_or_counterexample",
      "checks": [
        {
          "check": "eight_batch_pipeline_completion_ms",
          "actual": 70,
          "expected": 70,
          "unit": "ms",
          "relation": "sum(stage_ms) + (8 - 1) * max(stage_ms)",
          "passed": true
        },
        {
          "check": "eight_batch_serial_completion_ms",
          "actual": 112,
          "expected": 112,
          "unit": "ms",
          "relation": "8 * sum(stage_ms)",
          "passed": true
        },
        {
          "check": "first_batch_completion_ms",
          "actual": 14,
          "expected": 14,
          "unit": "ms",
          "relation": "sum(stage_ms)",
          "passed": true
        },
        {
          "check": "stage_resource_non_overlap",
          "actual": true,
          "expected": true,
          "unit": "predicate",
          "relation": "No two batches occupy the same stage resource simultaneously.",
          "passed": true
        },
        {
          "check": "input_slots_from_timeline",
          "actual": 2,
          "expected": 2,
          "unit": "slots",
          "relation": "ceil(10 ms / 8 ms)",
          "passed": true
        },
        {
          "check": "output_slots_from_timeline",
          "actual": 2,
          "expected": 2,
          "unit": "slots",
          "relation": "ceil(9 ms / 8 ms)",
          "passed": true
        },
        {
          "check": "device_buffers_mib",
          "actual": 34,
          "expected": 34,
          "unit": "MiB",
          "relation": "input_slots * 16 MiB + output_slots * 1 MiB; other allocations excluded",
          "passed": true
        }
      ]
    },
