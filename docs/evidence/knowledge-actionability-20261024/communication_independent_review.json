  "findings": [
    {
      "id": "R1",
      "severity": "medium",
      "status": "resolved",
      "required": true,
      "path": "knowledge/hardware/cpu-gpu-overlap.md",
      "line": 78,
      "heading": "用可区分实验选择同步、重叠或减少搬运",
      "current_text": "测量窗口须包含管线排空",
      "issue": "将有限批完成时间和稳态吞吐窗口合并为一个强制口径。有限批计时必须直到最后批完成；持续服务的稳态窗口可以与停止接入后的排空分开，但须定义窗口和在途请求的归属、追踪结局。当前绝对表述容易把稳态与有限 workload 的指标混用，也与 service-protocol 对稳态窗/排空的区分不一致。",
      "suggested_fix": "改为：有限批完成时间应计至最后一批完成；稳态吞吐应单列稳态测量窗口，并报告窗口边界的在途请求及窗口后结局。主机提交结束不能代替完成，排空时间另行报告。",
      "basis": "由章节自身 T_N 与 P_0 的不同指标定义及请求结局记账推导，不依赖 GPU 测量。",
      "resolved_in_sha256": "1a4eb23a214d12081e475035460f98082f3855739e2312ae1a1a41b2be8c76a0",
      "resolution": "已分别定义有限任务完成时间包含排空、明确稳态窗口及窗口两端在途工作/计数口径/窗口后结局；不再强制将稳态窗与排空混为一个口径。"
    },
    {
      "id": "R2",
      "severity": "low",
      "status": "resolved",
      "required": false,
      "path": "knowledge/system-semantics/distributed-execution-contracts.md",
      "line": 64,
      "heading": "成本模型要从实际不能隐藏的路径计算",
      "current_text": "单向有效链路带宽为 B；接收流量不能再乘入时间项。",
      "issue": "理想 ring 公式和数值正确；建议显式说明发送与接收方向可同时工作，B 是单向可持续带宽而不是双向共享总带宽。若方向竞争同一资源，需要重新合计该共享资源流量。",
      "suggested_fix": "在公式假设中加入“收发方向可并发，B 不是双向流量合计带宽”；在解释接收流量处补共享链路或半双工要单独建模。",
      "basis": "带宽单位及资源服务时间模型的适用范围；属于假设精化，不是当前理想模型下的计算错误。",
      "resolved_in_sha256": "ae97eb296bb0528ed2100677e6d50d066a9dedb8245a9f9e3034a7149488e5c2",
      "resolution": "已显式限定全双工、发送与接收可并发、B 是单向有效带宽；原公式与计算在此假设下成立。"
    }
  ],
